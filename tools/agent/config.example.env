MC_ANDROID_GRADLE_OPTS="-Xmx4g -Dfile.encoding=UTF-8"
MC_ANDROID_SDK_ROOT=/Users/minxiang/Library/Android/sdk

MC_SUPABASE_PROJECT_REF=REDACTED
